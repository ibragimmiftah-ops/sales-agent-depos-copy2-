# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL via Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sales_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Vector store
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=novaflow_kb
QDRANT_API_KEY=change-me-in-production
CHROMA_PERSIST_DIR=./chroma_data

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# LLM (required for real agent behavior)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...

# Calendar
DEFAULT_TIMEZONE=Europe/Helsinki
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
SLOT_DURATION_MINUTES=30

# Security (rotate in production)
SECRET_KEY=change-me-in-production-min-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Operational limits
MAX_MESSAGE_LENGTH=2000
MAX_CONVERSATION_TURNS=50
MAX_TOOL_CALLS_PER_RUN=5
MAX_RAG_TOP_K=10
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_PUBLIC_TOKEN_PER_MINUTE=10
RATE_LIMIT_OPERATOR_PER_MINUTE=120
REQUEST_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=20
TOOL_TIMEOUT_SECONDS=10

# Docker Compose secrets (required for docker compose up)
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
